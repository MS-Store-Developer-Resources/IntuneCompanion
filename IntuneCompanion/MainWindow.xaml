<Window x:Class="IntuneCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IntuneCompanion.ViewModels"
        Title="Intune Companion" Height="520" Width="950" MinHeight="500" MinWidth="500"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="140" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Intune Companion" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />

        <!-- App list -->
        <ListView Grid.Row="1" ItemsSource="{Binding Apps}" SelectedItem="{Binding SelectedApp}" Margin="0,0,0,12">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Display Name" Width="250" DisplayMemberBinding="{Binding DisplayName}" />
                    <GridViewColumn Header="Type" Width="60" DisplayMemberBinding="{Binding AppType}" />
                    <GridViewColumn Header="App ID" Width="250" DisplayMemberBinding="{Binding AppId}" />
                    <GridViewColumn Header="User SID" Width="320" DisplayMemberBinding="{Binding UserSid}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Log list -->
        <ListBox Grid.Row="2" ItemsSource="{Binding LogEntries}" Margin="0,0,0,12" FontFamily="Consolas" FontSize="11" x:Name="LogListBox" ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="4,1" />
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- Action buttons -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="📋 Log Viewer" Click="OpenLogViewer_Click" Padding="16,8"
                    VerticalAlignment="Center"/>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <CheckBox Content="Uninstall app as well" IsChecked="{Binding UninstallAsWell}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <Button Content="🔍 Dump Registry" Command="{Binding DumpDiagnosticsCommand}" Padding="16,8" Margin="0,0,8,0" />
                <Button Content="↻ Refresh" Command="{Binding RefreshCommand}" Padding="16,8" Margin="0,0,8,0" />
                <Button Content="☢ Nuke Selected App" Command="{Binding NukeCommand}" Padding="16,8" Foreground="White" Background="#C42B1C" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>